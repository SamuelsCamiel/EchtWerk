// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("mysql://Test:test:3306/Echtwerk")
}

model Account { 
  id        Int     @id @default(autoincrement()) 
  Username    Varchar
  Email   Varchar
  Password  String
  PermissionsLevel (?)
} 

model Permissions { 
  id    Int     @id @default(autoincrement()) 
  PermissionsLevel String  @unique
  accountId
} 



model PinPoints {
  id        Int     @id @default(autoincrement()) 
  Title
  Photo
  Video
  Description
  ShortDesc
  CompName
  StudentName
  Course
  FilterTag
  accountId
  filterNaam
}

models Filters {
  id        Int     @id @default(autoincrement()) 
  FilterKleur
  FilterNaam
}