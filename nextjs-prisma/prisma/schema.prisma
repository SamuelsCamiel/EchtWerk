// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"

}

model Account { 
  id        Int     @id @default(autoincrement()) 
  Username    String
  Email   String
  Password  String
  PermissionsId Permissions @relation(fields: [permissionsId], references: [id])
  permissionsId Int 
  Pinpoint PinPoints ?
} 

model Permissions { 
  id    Int     @id @default(autoincrement()) 
  PermissionsDesc String
  Accounts Account[]
} 
  
model PinPoints {
  id        Int     @id @default(autoincrement()) 
  Title   String
  Description   String
  ShortDesc   String
  CompName    String
  StudentName   String
  Course    String
  FilterColor   String
  FilterName    String
  AccountId Account @relation(fields: [accountId], references: [id])
  accountId   Int @unique
}

