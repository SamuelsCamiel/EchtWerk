// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("mysql://Test:test:3306/Echtwerk")
}

model Account { 
  id        Int     @id @default(autoincrement()) 
  Username    Varchar
  Email   Varchar
  Password  String
  Placeholder*    @relation(fields: [PermissionsLevel], references: [Int*])
  PermissionsLevel Int
} 

model Permissions { 
  id    Int     @id @default(autoincrement()) 
  PermissionsLevel Int
  Placeholder*    @relation(fields: [accountId], references: [id])
  accountId   Int
} 

model PinPoints {
  id        Int     @id @default(autoincrement()) 
  Title   Varchar
  Description   Text
  ShortDesc   Text
  CompName    Varchar
  StudentName   Varchar
  Course    Varchar
  FilterKleur   Varchar
  FilterNaam    Varchar
  Placeholder*    @relation(fields: [accountId], references: [id])
  accountId   Int 
}

